<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Live</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Live uses the camera to take photos and videos, scan receipts and documents, read card barcodes for Wallet, and the codes that link your devices and verify a contact for secure messages.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Live saves the photos and videos you take with its Camera to your photo library.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Live's Clock rings your alarms and timers, even in silent mode or a Focus.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Live counts and shows the photos and videos in your library. Nothing leaves your phone unless you choose to add it to Live.</string>
	<!-- Required by App Store Connect for any HealthKit app, even read-only. Liv never
	     asks for write access (HEALTH_DESIGN.md decision 5), so iOS never shows this. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Liv doesn't save anything to Apple Health. It only reads your workouts and activity rings.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Liv reads your workouts and activity rings from Apple Health to fill in your Exercise log. Liv never writes to Health.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Live uses Face ID to unlock your Documents each time you open them.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Live uses your location to show the weather where you are and to find nearby stores and restaurants.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Live uses the microphone when you talk to Liv, when you ask Shazam what song is playing, and when you practice speaking Dutch. Recordings stay on your iPhone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Live uses speech recognition to turn what you say to Liv into text, and to check the Dutch words and sentences you practice saying.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Live plays songs from your Apple Music subscription and shows your Apple Music library.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Podcast feeds still publish plain-http enclosures; allow them for
		     AVFoundation media loads only (not general networking). -->
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mrlukedevans.live.photos.refresh</string>
		<string>com.mrlukedevans.live.photos.process</string>
		<string>com.mrlukedevans.live.photos.sync.*</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
